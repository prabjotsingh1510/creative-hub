# Supabase project (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used for invites and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of this app (used in invite emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2 ---
# Email via Resend (resend.com). Leave RESEND_API_KEY empty in dev: emails are skipped and logged.
# Real delivery to your team needs a verified sending domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=Creative Hub <notifications@your-verified-domain.com>
# Secret for /api/cron/reminders (use a long random string, e.g. `openssl rand -hex 32`).
# The endpoint rejects every request if this is unset.
CRON_SECRET=

# --- Phase 3 (all optional) ---
# Web Push: generate keys with `npx web-push generate-vapid-keys`. Leave empty to keep push off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
# Error reporting (Sentry). Leave empty to keep it off.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
